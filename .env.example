# ─── Copy this file to .env and fill in your values ──────────────────────────
# NEVER commit .env to git.

# ─── MinIO cluster credentials ───────────────────────────────────────────────
MINIO_ROOT_USER=storguard
MINIO_ROOT_PASSWORD=storguard_secret_123

# ─── S3 endpoint (gateway load balancer) ─────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000

# Individual node endpoints (used for chaos targeting)
MINIO_NODE1=http://localhost:9101
MINIO_NODE2=http://minio2:9000
MINIO_NODE3=http://minio3:9000
MINIO_NODE4=http://minio4:9000

# Independent standalone secondary site (replication/failover target)
MINIO_SECONDARY_ENDPOINT=http://localhost:9200

# ─── Test configuration ───────────────────────────────────────────────────────
STORGUARD_ENV=local
STORGUARD_WORKERS=10
STORGUARD_OBJECTS=50

# ─── Jenkins ──────────────────────────────────────────────────────────────────
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=storguard_jenkins_123

# ─── Allure reporting ─────────────────────────────────────────────────────────
ALLURE_API_URL=http://localhost:5050
